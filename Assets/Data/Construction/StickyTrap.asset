  m_Name: StickyTrap
  m_EditorClassIdentifier: DarkLord.Runtime::DarkLord.Dungeon.BuildItemDefinition
  category: 2
  displayName: "\uB048\uB048\uC774 \uD568\uC815"
  description: "\uACF5\uACA9\uC18D\uB3C4: \uCD08\uB2F9 1\uD68C (1\uCD08 \uAC04\uACA9)\n\uBC94\uC704: \uC124\uCE58 \uCE78\uC758 1.6 \xD7 1.6\uC720\uB2DB\n\uD53C\uD574 \uC5C6\uC74C \xB7 \uC774\uB3D9\uC18D\uB3C4 50% \uAC10\uC18C \xB7 \uC9C0\uC18D 1.5\uCD08\n\n\uBC1C\uB3D9 \uC2DC \uBC94\uC704 \uC548\uC758 \uBAA8\uB4E0 \uC6A9\uC0AC\uC5D0\uAC8C \uB3D9\uC2DC\uC5D0 \uC801\uC6A9\uD569\uB2C8\uB2E4. \uAC19\uC740 \uC801\uC758 \uCF5C\uB77C\uC774\uB354\uAC00 \uC5EC\uB7EC \uAC1C\uC5EC\uB3C4 \uD55C \uBC88\uB9CC \uC801\uC6A9\uD569\uB2C8\uB2E4. \uB454\uD654\uB294 \uAC31\uC2E0\uB418\uBA70 \uACB9\uCE58\uBA74 \uAC00\uC7A5 \uAC15\uD55C \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4. \uC544\uAD70\uC5D0\uAC8C\uB294 \uC801\uC6A9\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uBE48 \uBC14\uB2E5\uC5D0 \uC124\uCE58\uD569\uB2C8\uB2E4. \uCE68\uC785 \uC911\uC5D0\uB294 \uB9C8\uC655 \uADFC\uCC98, \uC801\uACFC \uB5A8\uC5B4\uC9C4 \uC704\uCE58\uC5D0\uB9CC \uC124\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  icon: {fileID: 21300000, guid: b16bccd128ee2a94c911356686c7768c, type: 3}
